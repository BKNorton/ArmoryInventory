<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:ArmoryInventory.Domain.Models;assembly=ArmoryInventory.Domain"
             xmlns:vm="clr-namespace:ArmoryInventory.App.ViewModels"
             x:DataType="vm:MainViewModel"
             x:Class="ArmoryInventory.App.Views.MainPage"
             x:Name="InventoryMainPage"
             Title="Inventory">

    <Grid
        RowDefinitions="100,*,80"
        ColumnDefinitions="4*,*">

        <!--Background Image-->
        <Image
            Source="army_background.jpg"
            Grid.ColumnSpan="2"
            Grid.RowSpan="3"
            Aspect="AspectFill">
        </Image>

        <!--Search filters-->
        <HorizontalStackLayout
            Grid.Row="0"
            Spacing="10"
            HorizontalOptions="Start"
            VerticalOptions="Center"
            Padding="10">

            <SearchBar
                Text="{Binding FilterText}"
                Grid.Column="0"
                HorizontalOptions="Start"
                WidthRequest="200"
                HeightRequest="45"
                VerticalOptions="End"
                Placeholder="Search Item"
                IsSpellCheckEnabled="False"
                BackgroundColor="White">
            </SearchBar>

            <Picker
                ItemsSource="{Binding ItemTypePicker}"
                SelectedIndex="{Binding ItemTypeFilterIndex}"
                Grid.Column="1"
                Title="Type"
                WidthRequest="150"
                VerticalOptions="End"
                HorizontalOptions="Start"
                BackgroundColor="White"
                TitleColor="Orange">
            </Picker>

            <Picker
                ItemsSource="{Binding TrueOrFalsePicker}"
                SelectedIndex="{Binding HasCompFilterIndex}"
                Grid.Column="2"
                Title="Has All Components"
                WidthRequest="150"
                VerticalOptions="End"
                HorizontalOptions="Start"
                BackgroundColor="White"
                TitleColor="Orange">
            </Picker>

            <Picker
                ItemsSource="{Binding TrueOrFalsePicker}"
                SelectedIndex="{Binding MissCapFilterIndex}"
                Grid.Column="3"
                Title="Mission Capable"
                WidthRequest="150"
                VerticalOptions="End"
                HorizontalOptions="Start"
                BackgroundColor="White"
                TitleColor="Orange">
            </Picker>

            <Picker
                ItemsSource="{Binding TrueOrFalsePicker}"
                SelectedIndex="{Binding CheckOutFilterIndex}"
                Grid.Column="4"
                Title="Checked Out"
                WidthRequest="150"
                VerticalOptions="End"
                HorizontalOptions="Start"
                BackgroundColor="White"
                TitleColor="Orange">
            </Picker>
        </HorizontalStackLayout>

        <!--Table Header-->
        <StackLayout
            Grid.Row="1"
            HorizontalOptions="Start"
            VerticalOptions="Center"
            Padding="10">

            <Grid
                ColumnDefinitions="*,*,*,*,*">

                <Frame
                    Grid.Column="0"
                    Style="{StaticResource HeaderFrame}">

                    <Label 
                        Text="Serial Number"
                        HorizontalOptions="Start"
                        Margin="10,0,0,0"
                        Style="{StaticResource HeaderLable}">
                    </Label>
                </Frame>

                <Frame
                    Grid.Column="1"
                    Style="{StaticResource HeaderFrame}">

                    <Label 
                        Text="Item Type"
                        HorizontalOptions="Start"
                        Margin="10,0,0,0"
                        Style="{StaticResource HeaderLable}">
                    </Label>
                </Frame>

                <Frame
                    Grid.Column="2"
                    Style="{StaticResource HeaderFrame}">

                    <Label 
                        Text="Complete"
                        HorizontalOptions="Start"
                        Margin="10,0,0,0"
                        Style="{StaticResource HeaderLable}">
                    </Label>
                </Frame>

                <Frame
                    Grid.Column="3"
                    Style="{StaticResource HeaderFrame}">

                    <Label 
                        Text="Mission Capable"
                        HorizontalOptions="Start"
                        Margin="10,0,0,0"
                        Style="{StaticResource HeaderLable}">
                    </Label>
                </Frame>

                <Frame
                    Grid.Column="4"
                    Style="{StaticResource HeaderFrame}">

                    <Label 
                        Text="Checked Out"
                        HorizontalOptions="Start"
                        Margin="10,0,0,0"
                        Style="{StaticResource HeaderLable}">
                    </Label>
                </Frame>
            </Grid>

            <!--Inventory Table-->
            <CollectionView   
                ItemsSource="{Binding ItemCollection}"
                SelectedItem="{Binding SelectedItem}"   
                VerticalOptions="FillAndExpand"
                SelectionMode="Single"
                BackgroundColor="Black">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:Item">
                        <Grid
                            RowDefinitions="*"
                            ColumnDefinitions="*,*,*,*,*"
                            BackgroundColor="White">

                            <!--Item State Settings-->
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal" />
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="LightGrey" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Frame 
                                Grid.Column="0"
                                CornerRadius="0"
                                BorderColor="Black"
                                BackgroundColor="Transparent"
                                HorizontalOptions="FillAndExpand">

                                <Label 
                                    Text="{Binding SerialNumber}"
                                    HorizontalOptions="Start">
                                </Label>
                            </Frame>

                            <Frame 
                                Grid.Column="1"
                                CornerRadius="0"
                                BorderColor="Black"
                                BackgroundColor="Transparent"
                                HorizontalOptions="FillAndExpand">

                                <Label 
                                    Text="{Binding ItemType}"
                                    HorizontalOptions="Start">
                                </Label>
                            </Frame>

                            <Frame 
                                Grid.Column="2"
                                CornerRadius="0"
                                BorderColor="Black"
                                BackgroundColor="Transparent"
                                HorizontalOptions="FillAndExpand">

                                <Label 
                                    Text="{Binding HasAllComponents}"
                                    HorizontalOptions="Start">
                                </Label>
                            </Frame>

                            <Frame 
                                Grid.Column="3"
                                CornerRadius="0"
                                BorderColor="Black"
                                BackgroundColor="Transparent"
                                HorizontalOptions="FillAndExpand">

                                <Label 
                                    Text="{Binding MissionCapable}"
                                    HorizontalOptions="Start">
                                </Label>
                            </Frame>

                            <Frame 
                                Grid.Column="4"
                                CornerRadius="0"
                                BorderColor="Black"
                                BackgroundColor="Transparent"
                                HorizontalOptions="FillAndExpand">

                                <Label 
                                    Text="{Binding CheckedOut}"
                                    HorizontalOptions="Start">
                                </Label>
                            </Frame>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </StackLayout>

        <!--Add, Edit, Delete Buttons-->
        <VerticalStackLayout
            Grid.Column="1"
            Grid.Row="1"
            Spacing="5"
            Margin="0,60,0,0"
            HorizontalOptions="Start"
            VerticalOptions="Start">
            
            <Button
                Style="{StaticResource StandardButton}"
                Command="{Binding GoToAddItemPageCommand}"
                Text="Add">
            </Button>

            <Button
                Style="{StaticResource StandardButton}"
                Command="{Binding GoToViewItemPageCommand}"
                Text="View">
            </Button>

            <Button
                Style="{StaticResource StandardButton}"
                Command="{Binding DeleteItemCommand}"
                Margin="0,25,0,0"
                Text="Delete">
            </Button>
        </VerticalStackLayout>

        <!--Bottom Mission and Checkout Buttons-->
        <HorizontalStackLayout
            Grid.Column="0"
            Grid.Row="2"
            Spacing="25"
            HorizontalOptions="Center"
            VerticalOptions="Start">

            <Button
                Style="{StaticResource StandardButtonLarge}"
                Text="Checkout">
            </Button>

            <Button
                Style="{StaticResource StandardButtonLarge}"
                Text="Create Mission">
            </Button>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>