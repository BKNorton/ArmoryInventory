<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:m="clr-namespace:ArmoryInventory.Domain.Models;assembly=ArmoryInventory.Domain"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ArmoryInventory.App.ViewModels"
             x:DataType="vm:ItemViewModel"
             x:Class="ArmoryInventory.App.Views.ViewItemPage"
             Title="View Item">

    <Grid
        RowDefinitions="*,3*"
        ColumnDefinitions="*,*">

        <!--Background Image-->
        <Image
            Source="antenna_pic.png"
            Aspect="AspectFill"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2">
        </Image>

        <!--Top Stack (Item Essential Details)-->
        <HorizontalStackLayout
            Grid.Row="0"
            Grid.ColumnSpan="2"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <StackLayout
                MinimumWidthRequest="200">

                <Frame
                    Style="{StaticResource HeaderFrame}">

                    <Label
                        Text="Item Type"
                        Style="{StaticResource HeaderLable}">
                    </Label>
                </Frame>

                <Frame
                    CornerRadius="0"
                    BorderColor="Black"
                    Padding="5">

                    <Label
                        Text="{Binding Item.ItemType}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        FontSize="Small">
                    </Label>
                </Frame>
            </StackLayout>

            <StackLayout
                MinimumWidthRequest="200">

                <Frame
                    Style="{StaticResource HeaderFrame}">

                    <Label
                        Text="Serial Number"
                        Style="{StaticResource HeaderLable}">
                    </Label>
                </Frame>

                <Frame
                    CornerRadius="0"
                    BorderColor="Black"
                    Padding="5">

                    <Label
                        Text="{Binding Item.SerialNumber}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        FontSize="Small">
                    </Label>
                </Frame>
            </StackLayout>

            <StackLayout
                MinimumWidthRequest="200">

                <Frame
                    Style="{StaticResource HeaderFrame}">

                    <Label
                        Text="Mission Capable"
                        Style="{StaticResource HeaderLable}">
                    </Label>
                </Frame>

                <Frame
                    CornerRadius="0"
                    BorderColor="Black"
                    Padding="5">

                    <Label
                        Text="{Binding MissionCapable}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        FontSize="Small">
                    </Label>
                </Frame>
            </StackLayout>

            <StackLayout
                MinimumWidthRequest="200">
                
                <Frame
                    Style="{StaticResource HeaderFrame}">
                    
                    <Label
                        Text="Checked Out"
                        Style="{StaticResource HeaderLable}">
                    </Label>
                </Frame>

                <Frame
                    CornerRadius="0"
                    BorderColor="Black"
                    Padding="5">

                    <Label
                        Text="{Binding Item.CheckedOut}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        FontSize="Small">
                    </Label>
                </Frame>
            </StackLayout>

            <Button
                Margin="15,0,0,0"
                Style="{StaticResource StandardButton}"
                Text="Checkout">
            </Button>
        </HorizontalStackLayout>

        <!--Right Column (Checkout History)-->
        <Grid
            Grid.Row="1"
            Grid.Column="1"
            RowDefinitions="*"
            ColumnDefinitions="2*,*"
            Padding="50,50,0,50"
            HorizontalOptions="Center">

            <StackLayout
                Grid.Row="0"
                Grid.Column="0">

                <!--Header-->
                <Frame
                    Style="{StaticResource HeaderFrame}">

                    <Label
                        Text="Checkout History"
                        Style="{StaticResource HeaderLable}">
                    </Label>
                </Frame>

                
                <!--Collection-->
                <CollectionView
                    ItemsSource="{Binding CheckoutHistory}"
                    SelectionMode="Single"
                    VerticalOptions="FillAndExpand">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="m:Checkout"
>
                            <Grid
                                ColumnDefinitions="*,*"
                                BackgroundColor="White">

                                <!--Item State Settings-->
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal" />
                                        <VisualState Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="LightGrey" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Frame
                                    CornerRadius="0"
                                    Grid.Column="0"
                                    BackgroundColor="Transparent"
                                    BorderColor="Black">
                                    
                                    <StackLayout
                                        Padding="0">
                                        
                                        <Label
                                            TextColor="Black"
                                            Text="Date Checked out"
                                        FontAttributes="Bold">
                                        </Label>

                                        <Label
                                            TextColor="Black"
                                            Text="{Binding DateCheckedOut}">
                                        </Label>
                                    </StackLayout>
                                </Frame>

                                <Frame
                                    CornerRadius="0"
                                    Grid.Column="2"
                                    BackgroundColor="Transparent"
                                    BorderColor="Black">
                                    
                                    <StackLayout
                                        Padding="0">
                                        
                                        <Label
                                            TextColor="Black"
                                            Text="Checked out to"
                                            FontAttributes="Bold">
                                        </Label>

                                        <Label
                                            TextColor="Black"
                                            Text="{Binding CheckedOutTo}">
                                        </Label>
                                    </StackLayout>
                                </Frame>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>

            <!--Buttons-->
            <StackLayout
                Grid.Row="0"
                Grid.Column="1"
                Spacing="10"
                Padding="10,45,0,0"
                HorizontalOptions="Start">

                <Button
                    Style="{StaticResource StandardButton}"
                    Text="View">
                </Button>

                
            </StackLayout>
        </Grid>

        <!--Left Column (Item Details)-->
        <Grid
            Grid.Row="1"
            Grid.Column="0"
            RowDefinitions="*"
            ColumnDefinitions="2*,*"
            Padding="50,50,0,50"
            HorizontalOptions="Center">
            
            <StackLayout
                Grid.Row="0"
                Grid.Column="0"
                HorizontalOptions="Center">

                <!--Header-->
                <Frame
                    Style="{StaticResource HeaderFrame}">

                    <Label
                        Text="Item Details"
                        Style="{StaticResource HeaderLable}">
                    </Label>
                </Frame>

                <ScrollView 
                    VerticalOptions="FillAndExpand">
                    
                    <Grid
                        RowDefinitions="*,*">
                        
                        <Frame
                            Grid.Row="0"
                            CornerRadius="0"
                            BorderColor="Black"
                            BackgroundColor="LightGrey">

                            <StackLayout
                                Padding="10">

                                <Label 
                                    Text="Defects:"
                                    FontAttributes="Bold"
                                    Padding="5"
                                    HorizontalOptions="Center">
                                </Label>
                                
                                <Editor
                                    Text="{Binding Defects}"
                                    Placeholder="Defects"
                                    BackgroundColor="White"
                                    MinimumHeightRequest="180"
                                    VerticalOptions="FillAndExpand"
                                    IsReadOnly="True">
                                </Editor>
                            </StackLayout>
                        </Frame>

                        <Frame
                            Grid.Row="1"
                            CornerRadius="0"
                            BorderColor="Black"
                            BackgroundColor="LightGrey">

                            <StackLayout
                                Padding="10">

                                <Label 
                                    Text="Missing Components:"
                                    FontAttributes="Bold"
                                    Padding="5"
                                    HorizontalOptions="Center">
                                </Label>

                                <Editor
                                    Text="{Binding MissingComponents}"
                                    Placeholder="Missing Components"
                                    BackgroundColor="White"
                                    MinimumHeightRequest="180"
                                    VerticalOptions="FillAndExpand"
                                    IsReadOnly="True">
                                </Editor>
                            </StackLayout>
                        </Frame>
                    </Grid>
                </ScrollView>
            </StackLayout>

            <StackLayout
                Grid.Row="0"
                Grid.Column="1"
                Spacing="5"
                WidthRequest="100"
                HorizontalOptions="Center">

                <Label Text="Mission Capable"
                       WidthRequest="64"
                       TextColor="Orange"
                       BackgroundColor="Black"
                       Padding="5"
                       ></Label>

                <ImageButton
                    CornerRadius="90"
                    HeightRequest="20"
                    WidthRequest="20"
                    BackgroundColor="{Binding MissCapButtonColor}"
                    BorderColor="Black"
                    BorderWidth="1.5"
                    Source="{Binding MissCapButtonIcon}"
                    Aspect="Fill"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    ToolTipProperties.Text="Click to mark Mission Capable or Not Mission Capable"
                    Command="{Binding MissonCapableButtonPressedCommand}">
                </ImageButton>
            </StackLayout>
        </Grid>
    </Grid>
</ContentPage>